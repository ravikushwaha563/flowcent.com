// This is your Prisma schema file for Flowcent
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  passwordHash   String
  companyName    String?
  industry       String?
  gmailConnected Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  invoices       Invoice[]
  clients        Client[]
  
  @@map("users")
}

model Client {
  id                  String    @id @default(uuid())
  userId              String
  name                String
  email               String
  phone               String?
  company             String?
  paymentHistoryScore Int       @default(50)
  avgPaymentDelay     Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices            Invoice[]
  
  @@map("clients")
}

model Invoice {
  id                  String    @id @default(uuid())
  userId              String
  clientId            String
  invoiceNumber       String
  amount              Decimal   @db.Decimal(12, 2)
  currency            String    @default("INR")
  dueDate             DateTime
  status              String    @default("pending") // pending, paid, overdue, cancelled
  paymentIntentScore  Int       @default(50)
  fileUrl             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  paidAt              DateTime?
  
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  promises            Promise[]
  followUps           FollowUp[]
  
  @@map("invoices")
}

model Promise {
  id            String    @id @default(uuid())
  invoiceId     String
  promiseText   String    @db.Text
  promiseType   String    // date_specific, conditional, vague
  promisedDate  DateTime?
  fulfilled     Boolean   @default(false)
  emailId       String?
  createdAt     DateTime  @default(now())
  
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  @@map("promises")
}

model FollowUp {
  id              String    @id @default(uuid())
  invoiceId       String
  stage           String    // pre_reminder, due_date, first, second, final
  sentAt          DateTime  @default(now())
  openedAt        DateTime?
  repliedAt       DateTime?
  messageContent  String    @db.Text
  channel         String    @default("email") // email, whatsapp
  
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  @@map("follow_ups")
}
